# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required by src/lib/supabase/admin.ts, used by the anonymous guest signup
# route (POST/DELETE /api/matches/[matchId]/guest-signup), the scheduler tick
# and the cron routes below.

# OpenAI (used for AI team generation, falls back to a deterministic balancer if unset)
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o-mini

# App URL (for absolute URLs in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the scheduler routes, sent as `Authorization: Bearer $CRON_SECRET`:
#   /api/cron/tick   runs due scheduled jobs (auto-finish, result requests and
#                    reminders), match reminders and recurring matches, then
#                    drains the WhatsApp outbox and device push. Call it every
#                    minute from `npm run ticker` (scripts/ticker.ts,
#                    Dockerfile.ticker) or any external cron.
#   /api/cron/daily  the only route in vercel.json (12:00 UTC); a fallback tick
#                    for deploys without a ticker.
# Without a ticker, page loads also trigger a tick at most once a minute.
CRON_SECRET=a-long-random-string
# Optional for scripts/ticker.ts: the app URL to tick (defaults to
# NEXT_PUBLIC_APP_URL) and the interval in ms (default 60000, minimum 5000).
# TICKER_APP_URL=
# TICKER_INTERVAL_MS=60000

# Device notifications: generate once with `npx web-push generate-vapid-keys --json`.
# Only the public key is exposed to the browser. Keep the private key server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
