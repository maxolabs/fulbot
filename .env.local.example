# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server only. Required by src/lib/supabase/admin.ts: the anonymous guest signup
# route (POST/DELETE /api/matches/[matchId]/guest-signup), account deletion
# (/api/account/delete), the scheduler tick, the cron routes below, device push
# and /api/health.

# OpenAI (used for AI team generation, falls back to a deterministic balancer if unset)
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o-mini

# Public app URL, no trailing slash: invite and share links, Open Graph and
# the ticker's target. In production the same value is the Supabase Site URL
# and the Vault secret `fulbot_app_url`. On Vercel it falls back to
# https://$VERCEL_PROJECT_PRODUCTION_URL. A CI or Vercel build (or any build
# with FULBOT_STRICT_ENV=1) fails when neither is set; see docs/deploy.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the scheduler routes, sent as `Authorization: Bearer $CRON_SECRET`
# (generate with `openssl rand -hex 32`):
#   /api/cron/tick   runs due scheduled jobs (auto-finish, result requests and
#                    reminders), match reminders and recurring matches, then
#                    drains the WhatsApp outbox and device push. Something must
#                    call it every minute: in production the Supabase pg_cron
#                    job (migration 00036) with this same value stored in Vault
#                    as `fulbot_cron_secret`; locally `npm run ticker`
#                    (scripts/ticker.ts). See docs/deploy.md §4 and §9.
#   /api/cron/daily  the only route in vercel.json (12:00 UTC), a daily backstop.
# Signed-in page loads also trigger a tick at most once a minute.
CRON_SECRET=a-long-random-string
# Optional for scripts/ticker.ts: the app URL to tick (defaults to
# NEXT_PUBLIC_APP_URL) and the interval in ms (default 60000, minimum 5000).
# TICKER_APP_URL=
# TICKER_INTERVAL_MS=60000

# Device notifications: generate once with `npx web-push generate-vapid-keys --json`.
# Only the public key is exposed to the browser. Keep the private key server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: /api/health reports "degraded" when the last scheduler tick is
# older than this many minutes (default 10; the pg_cron job ticks every minute).
# HEALTH_MAX_TICK_AGE_MINUTES=10
