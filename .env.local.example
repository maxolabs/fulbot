# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required by src/lib/supabase/admin.ts, used by the anonymous guest signup
# route (POST/DELETE /api/matches/[matchId]/guest-signup).

# OpenAI (used for AI team generation, falls back to a deterministic balancer if unset)
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4o-mini

# App URL (for absolute URLs in emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
